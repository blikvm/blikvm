# Root-owned trusted shell file, chmod 600. Never publish real credentials.
ACME_DOMAIN=kvm.example.com
ACME_DNS_PROVIDER=route53
ACME_ACCOUNT_ID=blikvm
ACME_SERVER=letsencrypt
# Set to 1 only after accepting the CA subscriber agreement.
ACME_ACCEPT_TOS=0
# Optional: a reachable recursive DNS server, especially with negative LAN caches.
# ACME_DNS_RESOLVER=resolver-address:53
export AWS_REGION=us-east-1
export AWS_HOSTED_ZONE_ID=YOUR_HOSTED_ZONE_ID
export AWS_SHARED_CREDENTIALS_FILE=/data/work/extensions/lego/config/aws.credentials
export AWS_EC2_METADATA_DISABLED=true
